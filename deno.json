{
    "compilerOptions": {
        "strict": true,
        "noUncheckedIndexedAccess": true,
        "noImplicitOverride": true,
        "noImplicitReturns": true,
        "noFallthroughCasesInSwitch": true,
        "exactOptionalPropertyTypes": true,
        "verbatimModuleSyntax": true
    },
    "fmt": {
        "semiColons": true,
        "lineWidth": 100,
        "indentWidth": 4,
        "useTabs": false,
        "exclude": ["WhatToGit.md", "leftoverbits.md", "bitignore"]
    },
    "lint": {
        "rules": {
            "tags": ["recommended"],
            "include": [
                "explicit-function-return-type",
                "explicit-module-boundary-types"
            ]
        }
    },
    "tasks": {
        "dev": "deno run --allow-net --allow-run=git --allow-read --allow-env=HOME --allow-write src/main.ts"
    }
}
